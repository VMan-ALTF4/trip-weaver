# ==========================================
# 1. GIAO DIỆN (Client-side / VITE_*)
# ==========================================
# URL dự án Supabase (Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Anon/Public API Key của Supabase (Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 2. SERVER (Backend / SSR / Database / Lovable)
# ==========================================
# URL dự án Supabase dùng cho SSR/Server (Thường giống VITE_SUPABASE_URL, lấy từ Supabase Dashboard)
SUPABASE_URL=

# Anon Key dùng cho SSR/Server (Thường giống VITE_SUPABASE_ANON_KEY, lấy từ Supabase Dashboard)
SUPABASE_ANON_KEY=

# Service Role Secret Key của Supabase - quyền admin server (Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role). TUYỆT ĐỐI không để lộ ở client!
SUPABASE_SERVICE_ROLE_KEY=

# URL kết nối trực tiếp PostgreSQL dùng để chạy migration Drizzle (Lấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string)
LOVABLE_DB_MIGRATION_URL=

# Secret key xác thực các webhook/cron nội bộ của Lovable (Tự sinh chuỗi bảo mật hoặc lấy từ cấu hình Lovable cron)
LOVABLE_CRON_SECRET=

# Secret key dự phòng hỗ trợ xoay vòng secret key cron (Tùy chọn, chuỗi secret trước đó)
LOVABLE_CRON_SECRET_PREVIOUS=

# ==========================================
# 3. VÉ ĐIỆN TỬ (ETICKET_* - Ký số & Xác thực vé QR)
# Tạo nhanh cặp khóa ES256 (P-256) bằng lệnh: node scripts/generate-eticket-keys.mjs
# ==========================================
# Mã định danh khóa ký hiện tại (Lấy từ kết quả chạy lệnh sinh khóa, ví dụ: key-2026-03 hoặc chuỗi UUID/timestamp)
ETICKET_KEY_ID=

# Chuỗi định danh tổ chức/dịch vụ phát hành vé trong JWT claim 'iss' (Mặc định thường là: tat-booking)
ETICKET_ISSUER=

# Khóa bí mật (Private Key định dạng PKCS#8 PEM) dùng để ký vé điện tử (Lấy từ kết quả lệnh sinh khóa). Server-only!
ETICKET_PRIVATE_KEY=

# Khóa công khai (Public Key định dạng SPKI PEM) dùng để xác thực chữ ký vé (Lấy từ kết quả lệnh sinh khóa)
ETICKET_PUBLIC_KEY=

# Danh sách khóa công khai cũ hỗ trợ xoay vòng khóa (Dạng mảng JSON: [{"kid":"...","pem":"..."}, ...]. Mặc định để [])
ETICKET_ADDITIONAL_PUBLIC_KEYS=[]

# ==========================================
# 4. EMAIL & ĐIỀU HƯỚNG (Resend API & URLs)
# ==========================================
# API Key của Resend để gửi email vé điện tử (Lấy tại: https://resend.com/api-keys)
RESEND_API_KEY=

# Địa chỉ email người gửi đã xác thực trên Resend (Ví dụ: TAT Booking <noreply@yourdomain.com>)
RESEND_FROM_EMAIL=

# Địa chỉ URL gốc của ứng dụng web, dùng gắn link xem vé trong email (Môi trường local: http://localhost:3000)
APP_URL=

# Tùy chọn thay thế cho APP_URL nếu hệ thống deployment dùng PUBLIC_URL
PUBLIC_URL=

# Tùy chọn thay thế cho APP_URL nếu hệ thống deployment dùng SITE_URL
SITE_URL=
